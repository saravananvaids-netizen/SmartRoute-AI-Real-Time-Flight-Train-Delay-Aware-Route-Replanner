# SmartRoute AI - Environment Variables Configuration

# Amadeus Flight API Credentials (Self-service test keys: https://developers.amadeus.com)
AMADEUS_CLIENT_ID="1234"

AMADEUS_CLIENT_SECRET="1234"

# RailRadar / Indian Railways API Key (https://railradar.in or RapidAPI Rail endpoint)
RAIL_RADAR_API_KEY="1234"

# Demonstration Mode (Set to true to use verified offline realistic data when API keys are not supplied)
ENABLE_DEMO_MODE=true

# Port Configuration (Defaults to 8501 for Streamlit, 3000 for AI Studio Web Preview)
PORT=8501
